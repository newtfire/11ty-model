---
layout: base.njk
---

{{ content | safe }}

<is-land on:visible>
  <div id="gallery" v-scope="{ active: 'none' }">
    <section class="pushButton">
       <button @click="active = 'all'" :class="{ on: active === 'all' }" :aria-pressed="active === 'all'">All</button>
      {% for topic, images in gallery %}
      <button @click="active = '{{ topic }}'" :class="{ on: active === '{{ topic }}' }" :aria-pressed="active === '{{ topic }}'">{{ topic }} ({{ images.length }})</button>
      {% endfor %}
    </section>
    <p aria-live="polite">Showing: <span v-text="active"></span></p>
    {% for topic, images in gallery %}
    <section class="gallery" v-show="active === 'all' || active === '{{ topic }}'">
      <h3>{{ topic }}</h3>
      <div class="flex">
        {% for image in images %}
        <figure>
          <img src="img/{{ topic }}/{{ image.file }}" alt="{{ image.caption or image.alt }}">
          <figcaption>{{ image.alt }}</figcaption>
        </figure>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>

  <template data-island>
    <script type="module">
      import { createApp } from './js/petite-vue.js'
      createApp().mount('#gallery')
    </script>
  </template>
</is-land>
